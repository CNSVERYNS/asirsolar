# Local development works without DATABASE_URL (embedded PostgreSQL in .data/postgres).
# Vercel: Supabase Connect > Transaction pooler; use its URI on port 6543.
# Keep this server-only. Never prefix database credentials with NEXT_PUBLIC_.
DATABASE_URL=
# If Supabase requires its CA certificate, paste the PEM using escaped newlines.
DATABASE_SSL_CA=

# Production: both origins must be https://www.asirsolar.com (apex redirects to www).
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.asirsolar.com
# Search Console > URL prefix > HTML tag: content value only; rebuild after setting.
GOOGLE_SITE_VERIFICATION=

# Verified WhatsApp recipient; public values, included in the client build.
# Set BOTH values and rebuild to enable desktop/mobile/contact buttons.
NEXT_PUBLIC_WHATSAPP_PHONE=905419243545
NEXT_PUBLIC_WHATSAPP_NAME="Onur Durak"
# Enable only behind a proxy that overwrites x-forwarded-for. Vercel is detected automatically.
CRM_TRUST_PROXY=false

# Customer receipt + two engineer emails; two engineer SMS messages.
# Keep flags false until provider/account checks pass. See ZOHO_NETGSM_KURULUM.md.
# Old held jobs are NOT released automatically when a flag is enabled.
CRM_EMAIL_ENABLED=false
# Explicit provider prevents falling back to SMTP when a ZeptoMail token is missing.
CRM_EMAIL_PROVIDER=zeptomail
# Agent > SMTP/API > Send Mail Token (raw token, without Authorization prefix).
# Server-only SECRET. Do not configure the production token in Preview/Development.
CRM_ZEPTOMAIL_TOKEN=
CRM_EMAIL_FROM="Asır Solar İletişim <iletisim@asirsolar.com>"
CRM_EMAIL_REPLY_TO=iletisim@asirsolar.com
# Legacy SMTP only (CRM_EMAIL_PROVIDER=smtp); not used by ZeptoMail REST.
CRM_SMTP_HOST=
CRM_SMTP_PORT=587
CRM_SMTP_USER=
CRM_SMTP_PASSWORD=
CRM_SMS_ENABLED=false
CRM_SMS_PROVIDER=netgsm
CRM_NETGSM_USERCODE=
CRM_NETGSM_PASSWORD=
CRM_NETGSM_HEADER=
# Random 32+ character secret shared by Vercel and the Supabase Vault cron job.
CRON_SECRET=
